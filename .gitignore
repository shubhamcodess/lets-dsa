# Secrets — never commit
.env
.claude/CLAUDE.md

# Local overrides
config/user.json

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# Curriculum source dumps are large and refetchable
curriculum/sources/*.raw.json

# macOS junk anywhere in the tree
**/.DS_Store

# Large refetchable source dumps
curriculum/sources/*.raw.html
curriculum/sources/_system-roots.pem

# ---- personal data: never on the public branch ----
# These are tracked on `personal-main` only (force-added there once by
# scripts/dsa-git.py init-personal). Listing them here means they can never be
# added by accident while you are on main. See docs/MODES.md.
config/user.json
questions/**/*.md
topics/*.md
state/current.json
state/current.md
state/stats.json
state/oa-attempts.json
state/confusion.json
curriculum/track.md
.contrib/

# career-os-style personal worktree — never committed
.personal-worktree/
