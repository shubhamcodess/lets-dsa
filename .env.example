# Copy to .env and fill in. .env is gitignored on every branch.

# ---- PERSONALIZE ----
# true  = you are learning. Your data is written here and backed up to the PRIVATE
#         repo by scripts/sync-vault.sh. Claude runs in Personal Mode.
# false = you are working on the tool itself. Claude runs in Framework Mode and will
#         not create any personal files.
PERSONALIZE=false

# Your PRIVATE repo. Required when PERSONALIZE=true.
# Use the SSH host alias, not plain github.com — plain github.com authenticates with
# the wrong key on this machine. See .claude/CLAUDE.md.
PRIVATE_REPO_URL=git@github-lets-dsa:shubhamcodess/lets-dsa-sp.git

# ---- LeetCode auth (OPTIONAL, off by default) ----
# Leave blank to run public-only. Everything works without it, except that
# "I solved it" is taken on trust rather than verified against your account.
#
# To enable: paste your LEETCODE_SESSION cookie here, then add
#   "--session", "<value>"
# to the args in mcp/.mcp.json.
#
# Where to find it: leetcode.com -> devtools -> Application -> Cookies -> LEETCODE_SESSION
LEETCODE_SESSION=

# ---- Defaults (overridden by config/user.json once setup has run) ----
LEVEL=beginner
